{
  "name": "pykasi-language",
  "displayName": "PyKasi Language Support",
  "description": "Sintaks PyKasi: bacot, danta, kagadanta, dan operator kata rasa Bekasi.",
  "version": "1.1.0",
  "publisher": "pykasi-dev",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pykasi",
        "aliases": [
          "PyKasi",
          "pykasi",
          "Bekasi"
        ],
        "extensions": [
          ".bks"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "assets/logo.svg",
          "dark": "assets/logo.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "pykasi",
        "scopeName": "source.pykasi",
        "path": "./syntaxes/pykasi.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pykasi",
        "path": "./snippets/pykasi-snippets.json"
      }
    ],
    "themes": [
      {
        "label": "PyKasi Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/pykasi-dark.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FARILtau72/pykasi"
  },
  "keywords": [
    "pykasi",
    "bekasi",
    "indonesian",
    "programming language",
    "bahasa indonesia"
  ],
  "author": {
    "name": "PyKasi Team"
  },
  "license": "MIT"
}
