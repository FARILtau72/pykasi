{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PyKasi",
  "scopeName": "source.pykasi",
  "fileTypes": ["bks"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.pykasi",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pykasi",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pykasi",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.pykasi",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.pykasi",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.pykasi",
          "match": "\\b(kalo|kalo_kaga|valid|hoax)\\b"
        },
        {
          "name": "keyword.control.loop.pykasi",
          "match": "\\b(puterin|terus|berhenti)\\b"
        },
        {
          "name": "keyword.control.flow.pykasi",
          "match": "\\b(balikin)\\b"
        },
        {
          "name": "keyword.control.exception.pykasi",
          "match": "\\b(coba|tangkep)\\b"
        },
        {
          "name": "keyword.declaration.function.pykasi",
          "match": "\\b(fungsi|lamda)\\b"
        },
        {
          "name": "keyword.declaration.variable.pykasi",
          "match": "\\b(duit|omongan|gudang|catetan)\\b"
        },
        {
          "name": "keyword.other.import.pykasi",
          "match": "\\b(impor|dari|sebagai)\\b"
        },
        {
          "name": "keyword.other.statement.pykasi",
          "match": "\\b(spill|gas|dalam)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.pykasi",
          "match": "(\\+|\\-|\\*|\\/|\\%|\\*\\*)"
        },
        {
          "name": "keyword.operator.comparison.pykasi",
          "match": "(==|!=|>=|<=|>|<)"
        },
        {
          "name": "keyword.operator.assignment.pykasi",
          "match": "(GAS|=>)"
        },
        {
          "name": "punctuation.separator.pykasi",
          "match": "(;|,|:|\\.|\\(|\\)|\\[|\\]|\\{|\\})"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.pykasi",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.pykasi",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
