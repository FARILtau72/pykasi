{
  "Bacot": {
    "prefix": [
      "bacot",
      "spill"
    ],
    "body": "bacot ${1:\"Woy, Bekasi!\"};",
    "description": "Tampilkan nilai ke layar."
  },
  "Kasih nilai": {
    "prefix": "gas",
    "body": "${1:nama} gas ${2:\"Bekasi\"};",
    "description": "Isi variabel."
  },
  "Duit": {
    "prefix": "duit",
    "body": "duit ${1:patungan} gas ${2:10000};",
    "description": "Variabel angka."
  },
  "Omongan": {
    "prefix": "omongan",
    "body": "omongan ${1:asal} gas ${2:\"Bekasi\"};",
    "description": "Variabel teks."
  },
  "Danta": {
    "prefix": [
      "danta",
      "valid"
    ],
    "body": "danta ${1:paham} gas ${2:danta};",
    "description": "Variabel boolean benar atau salah."
  },
  "Kagadanta": {
    "prefix": "kagadanta",
    "body": "${1:paham} gas kagadanta;",
    "description": "Isi variabel dengan False."
  },
  "Kalo": {
    "prefix": "kalo",
    "body": [
      "kalo ${1:danta} {",
      "\tbacot ${2:\"Danta, bre.\"};",
      "}"
    ],
    "description": "Jalankan kalau kondisi benar."
  },
  "Kalo kaga": {
    "prefix": [
      "kalokaga",
      "kaloelse"
    ],
    "body": [
      "kalo ${1:danta} {",
      "\tbacot ${2:\"Gas lanjut.\"};",
      "} kaga {",
      "\tbacot ${3:\"Tanya dulu, bre.\"};",
      "}"
    ],
    "description": "Percabangan dengan else."
  },
  "Puterin": {
    "prefix": "puterin",
    "body": [
      "duit ${1:putaran} gas 1;",
      "puterin ${1:putaran} <= ${2:3} {",
      "\tbacot ${1:putaran};",
      "\t${1:putaran} gas ${1:putaran} tambah 1;",
      "}"
    ],
    "description": "Perulangan dengan penghitung."
  },
  "Fungsi": {
    "prefix": "fungsi",
    "body": [
      "fungsi ${1:tambah}(${2:a}, ${3:b}) {",
      "\tbalikin ${2:a} tambah ${3:b};",
      "}"
    ],
    "description": "Fungsi yang mengembalikan nilai."
  },
  "Balikin": {
    "prefix": "balikin",
    "body": "balikin ${1:hasil};",
    "description": "Return, dipakai di dalam fungsi."
  },
  "Lambda": {
    "prefix": "lamda",
    "body": "${1:kali_dua} gas lamda (${2:x}) => ${2:x} kali ${3:2};",
    "description": "Fungsi anonim."
  },
  "Coba tangkep": {
    "prefix": "coba",
    "body": [
      "coba {",
      "\tbacot ${1:1 bagi 0};",
      "} tangkep {",
      "\tbacot ${2:\"Ada yang kagadanta, bre.\"};",
      "}"
    ],
    "description": "Tangkap error saat eksekusi."
  },
  "Terus": {
    "prefix": "terus",
    "body": "terus;",
    "description": "Lanjut iterasi, dipakai di dalam loop."
  },
  "Berhenti": {
    "prefix": "berhenti",
    "body": "berhenti;",
    "description": "Berhenti, dipakai di dalam loop."
  },
  "Impor": {
    "prefix": "impor",
    "body": "impor ${1:math};",
    "description": "Impor modul Python yang didukung."
  },
  "Dari": {
    "prefix": "dari",
    "body": "dari ${1:math} impor ${2:sqrt};",
    "description": "Impor nama dari modul."
  },
  "Impor sebagai": {
    "prefix": "imporsbg",
    "body": "impor ${1:math} sebagai ${2:mtk};",
    "description": "Impor dengan alias."
  },
  "List": {
    "prefix": [
      "list",
      "gudang"
    ],
    "body": "${1:angka} gas [${2:1, 2, 3}];",
    "description": "List tanpa kata kunci tipe."
  },
  "Dictionary": {
    "prefix": [
      "dict",
      "catetan"
    ],
    "body": "${1:data} gas {${2:\"asal\": \"Bekasi\"}};",
    "description": "Dictionary tanpa kata kunci tipe."
  },
  "Tambah": {
    "prefix": "tambah",
    "body": "${1:hasil} gas ${2:10} tambah ${3:5};",
    "description": "Penjumlahan angka, string, atau list."
  }
}
